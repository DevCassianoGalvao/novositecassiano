# Copie este arquivo para .env e preencha os valores.
# Recomendado: colocar o .env UM NÍVEL ACIMA da pasta pública do site
# (ex.: /home/usuario/.env quando o site está em /home/usuario/public_html).
# Se ficar na raiz do site, o .htaccess já bloqueia o acesso pelo navegador.

# Chave da API da Brevo (Brevo > SMTP & API > API Keys)
BREVO_API_KEY=

# Para onde o lead vai
MAIL_TO=cassianogalvao2020@gmail.com
MAIL_TO_NAME="Cassiano Galvão"

# Remetente: precisa ser um remetente/domínio validado na Brevo
MAIL_FROM=contato@cassianogalvao.com.br
MAIL_FROM_NAME="Site Cassiano Galvão"

# Assunto do e-mail
MAIL_SUBJECT="Novo contato vindo do site!"

# Domínios autorizados a enviar o formulário (separados por vírgula). Vazio = sem checagem.
ALLOWED_ORIGINS=https://cassianogalvao.com.br,https://www.cassianogalvao.com.br

# ---------------------------------------------------------------
# Sistema de assinaturas (painel em /admin)
# ---------------------------------------------------------------
# Banco MySQL (cPanel > Bancos de Dados MySQL). Nome e usuário levam o prefixo da conta.
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# Endereço do site (sem barra no final)
APP_URL=https://cassianogalvao.com.br

# Chave que protege o Access Token do Mercado Pago no banco. Gere uma e NUNCA troque depois.
# (sugestão: copie o resultado de https://www.random.org/strings/ ou rode: openssl rand -hex 32)
APP_KEY=

# Senha única para liberar a primeira instalação em /admin/install.php
INSTALL_KEY=

# Chave para rodar a rotina diária por URL (opcional; use letras e números)
CRON_KEY=

# Pasta dos arquivos do briefing (opcional). Padrão: assinaturas-arquivos/ ao lado da pasta do domínio
#UPLOAD_DIR=/home/SEU_USUARIO/assinaturas-arquivos
